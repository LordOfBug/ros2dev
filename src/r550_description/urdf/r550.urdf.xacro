<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="r550_robot">

    <!-- 1. 物理参数定义 -->
    <xacro:property name="base_length" value="0.30"/>
    <xacro:property name="base_width" value="0.20"/>
    <xacro:property name="base_height" value="0.10"/>
    <xacro:property name="wheel_radius" value="0.04"/>
    <xacro:property name="wheel_width" value="0.04"/>
    <xacro:property name="wheel_ygap" value="0.02"/>
    <xacro:property name="wheel_xoff" value="0.10"/>
    <xacro:property name="wheel_zoff" value="0.04"/>

    <!-- 【计算防错】：直接预设轮子在 Y 轴的精确坐标 0.14m (0.10 + 0.02 + 0.02)，完全避免 Xacro 加减法计算冲突 -->
    <xacro:property name="wheel_yoff" value="0.14"/>

    <!-- 2. 惯性矩阵宏定义 -->
    <xacro:macro name="inertial_box" params="mass x y z">
        <inertial>
            <mass value="${mass}"/>
            <inertia ixx="${(1/12)*mass*(y*y+z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12)*mass*(x*x+z*z)}" iyz="0.0"
                     izz="${(1/12)*mass*(x*x+y*y)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_cylinder" params="mass radius length">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <!-- 【物理稳定化】：人工注入高稳定性惯性数值，确保物理求解器稳如磐石 -->
            <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                     iyy="0.002" iyz="0.0"
                     izz="0.001"/>
        </inertial>
    </xacro:macro>

    <!-- 3. 机器人原点和基础坐标系 -->
    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius + wheel_zoff}" rpy="0 0 0"/>
    </joint>

    <!-- 4. 车身底盘（Chassis Link） -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 ${base_height/2}"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="silver">
                <color rgba="0.75 0.75 0.75 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 ${base_height/2}"/>
            <geometry>
                <box size="${base_length - 0.02} ${base_width - 0.02} ${base_height - 0.02}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="5.0" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </link>

    <gazebo reference="base_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <!-- 5. 轮子宏定义 -->
    <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.5" radius="${wheel_radius}" length="${wheel_width}"/>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <!-- 极简无冲突坐标拼接，彻底消灭乘法 Bug -->
            <origin xyz="${x_reflect * wheel_xoff} ${y_reflect * wheel_yoff} ${-wheel_zoff}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <!-- 【接触力学优化 1】：将关节阻尼和摩擦力设为极低值 0.001，给小车轴承涂上完美的虚拟润滑油 -->
            <dynamics damping="0.001" friction="0.001"/>
        </joint>

        <gazebo reference="${prefix}_wheel">
            <material>Gazebo/Black</material>
            <!-- 恢复稳定且专为滑移转向优化的力学参数：
                 - mu1 设为 1.0：提供强劲的纵向抓地力，保证小车能前进/后退
                 - mu2 设为 0.15：提供适当的侧向滑动摩擦力，消除侧滑死锁的同时防止像在冰上一样甩尾
                 - kp (stiffness) 设为 1e6：提供足够的接触刚度
                 - kd (damping) 设为 100：吸收震动
                 - minDepth 设为 0.001：允许穿透容差防卡死
                 - maxVel 设为 0.1：限制最大接触速度，稳定物理求解器 -->
            <mu1>0.5</mu1>
            <mu2>0.05</mu2>
            <fdir1>1 0 0</fdir1>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>0.1</maxVel>
        </gazebo>
    </xacro:macro>

    <!-- 实例化4个轮子 -->
    <xacro:wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
    <xacro:wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
    <xacro:wheel prefix="back_left"   x_reflect="-1" y_reflect="1"/>
    <xacro:wheel prefix="back_right"  x_reflect="-1" y_reflect="-1"/>

    <!-- 6. 激光雷达（LiDAR）部分 -->
    <link name="laser_link">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.04"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 0.8 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_link"/>
        <origin xyz="0.08 0 ${base_height + 0.02}" rpy="0 0 0"/>
    </joint>

    <!-- 7. Gazebo 激光雷达传感器插件 -->
    <gazebo reference="laser_link">
        <material>Gazebo/Blue</material>
        <sensor name="lidar" type="ray">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <update_rate>10</update_rate>
            <visualize>true</visualize>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159265</min_angle>
                        <max_angle>3.14159265</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.28</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>laser_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- 8. 四驱滑移控制器插件 -->
    <gazebo>
        <plugin name="skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
            <ros>
                <remapping>cmd_vel:=cmd_vel</remapping>
                <remapping>odom:=odom</remapping>
            </ros>
            <update_rate>50</update_rate>
            <num_wheel_pairs>2</num_wheel_pairs>
            
            <left_joint>front_left_wheel_joint</left_joint>
            <left_joint>back_left_wheel_joint</left_joint>
            
            <right_joint>front_right_wheel_joint</right_joint>
            <right_joint>back_right_wheel_joint</right_joint>
            
            <wheel_separation>0.28</wheel_separation>
            <wheel_separation>0.28</wheel_separation>
            
            <wheel_diameter>0.08</wheel_diameter>
            <wheel_diameter>0.08</wheel_diameter>
            
            <!-- 限制最大扭矩以确保 Gazebo ODE 物理求解器稳定运行，防止关节瞬间撕裂或物理锁死 -->
            <max_wheel_torque>15.0</max_wheel_torque>
            
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <!-- 彻底关闭 Gazebo 内部不稳定的轮子 TF 发布 -->
            <publish_wheel_tf>false</publish_wheel_tf>
            <publish_wheel_joint_state>false</publish_wheel_joint_state>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
        </plugin>
    </gazebo>

    <!-- 9. 【核心修复 3 - 关节状态发布器插件】：确保 RViz2 100% 接收到轮子旋转数据
         直接在 URDF 里调用官方最稳定的 Joint State Publisher，强行向整个 ROS 2 网络广播轮子关节数据。
         这可以保证无论你在 Foxglove 还是在本地 RViz2 里看，轮子都会 100% 出现并跟随车身运动！ -->
    <gazebo>
        <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
            <ros>
                <remapping>~/out:=joint_states</remapping>
            </ros>
            <update_rate>50</update_rate>
            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>
            <joint_name>back_left_wheel_joint</joint_name>
            <joint_name>back_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

</robot>
